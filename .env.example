# u1s12api-go 配置（首次启动自动生成；管理后台修改后自动写回）
HOST=0.0.0.0
PORT=8080
# ADMIN_PASSWORD=   ← 首次启动随机生成，请查看启动日志
UPSTREAM_BASE_URL=https://api.u1s1.io/v1
EGRESS_PROXY_URL=
FINGERPRINT_PROFILE=auto
U1S1_VERSION=1.5.0
LOG_LEVEL=info
LOG_COLOR=true
QUOTA_AUTO_REFRESH=true
# BARK_KEY=                  ← Bark 推送密钥（api.day.app/<key>），官网公告/更新记录/CLI 新版本变化时推送；空=只入库展示不推送
# SITEFEED_CHECK_HOURS=24    ← 官网公告/更新记录检查间隔（小时），0=恢复默认 24
